# Copy this file to azure_bot_service/.env and replace the placeholders.
# Never commit the real .env file.

# Azure Bot / Microsoft Entra registration
MICROSOFT_APP_ID=your-bot-application-client-id
MICROSOFT_APP_PASSWORD=your-client-secret-value
MICROSOFT_APP_TENANT_ID=your-microsoft-entra-tenant-id
MICROSOFT_APP_TYPE=SingleTenant

# Existing FastAPI HRMS agent backend
AGENT_BACKEND_URL=http://127.0.0.1:3978
AGENT_BACKEND_API_KEY=use-one-long-random-internal-key

# HR provider used by the existing FastAPI backend: mock, rest, or mcp
HRMS_PROVIDER=mock
ENABLE_TEST_CHAT=true
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Gateway runtime
AZURE_BOT_PORT=3979
AZURE_BOT_TIMEOUT_SECONDS=15
AZURE_BOT_ALLOW_EMULATOR=true

# Development mapping: Entra object ID -> ERPNext employee ID
# Replace with a database-backed identity/token service in production.
AZURE_BOT_AAD_EMPLOYEE_MAP={"your-test-user-object-id":"EMP001"}

